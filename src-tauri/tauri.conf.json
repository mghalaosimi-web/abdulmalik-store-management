{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "عبدالملك لإدارة المتجر",
  "version": "0.1.0",
  "identifier": "com.abdulmalik.storemanagement",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "عبدالملك | إدارة المتجر",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "نظام إدارة محل اتصالات وإلكترونيات",
    "longDescription": "نظام محلي لإدارة المنتجات والمبيعات والمخزون والصيانة والحسابات.",
    "category": "Business",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:abdulmalik-store.db"
      ]
    }
  }
}
